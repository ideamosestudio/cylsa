---
import OptimizedImage from './OptimizedImage.astro';
import { brands } from '../data/brands';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section class="brand-ticker" aria-label="Marcas de neumáticos disponibles">
  <div class="brand-ticker__meta" aria-hidden="true">
    <span>CYL / MULTIMARCA</span>
    <i></i>
    <span>{brands.length} MARCAS</span>
  </div>
  <div class="brand-ticker__viewport">
    <div class="brand-ticker__track">
      {[0, 1].map((copy) => (
        <div class="brand-ticker__group" aria-hidden={copy === 1}>
          {brands.map(({ name, file, width, x, y }) => (
            <div class="brand-ticker__item" style={`--logo-width: ${width}px; --logo-x: ${x}%; --logo-y: ${y}%`}>
              <OptimizedImage src={`${base}images/brand-ticker/${file}`} alt={copy === 0 ? name : ''} sizes={`${width}px`} loading="lazy" decoding="async" />
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
