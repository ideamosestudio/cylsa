---
import OptimizedImage from './OptimizedImage.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const brands = [
  // Optical widths and offsets account for the original square canvases.
  ['Pirelli', 'pirelli.png', 185, -0.36, -1.36],
  ['Michelin', 'michelin.png', 155, -0.68, -0.96],
  ['Bridgestone', 'bridgestone.png', 120, 0.12, -1.32],
  ['Firestone', 'firestone.png', 225, 0, -0.52],
  ['Goodyear', 'goodyear.png', 225, -0.32, -1.12],
  ['Fate', 'fate.png', 170, -0.48, -3.03],
  ['Continental', 'continental.png', 240, 0.04, 0.24],
  ['Dunlop', 'dunlop.png', 235, -0.24, -0.24],
  ['Yokohama', 'yokohama.png', 235, 0.04, 0.08],
  ['BFGoodrich', 'bfgoodrich.png', 225, -0.84, -0.56],
  ['Hankook', 'hankook.png', 235, -0.56, -0.16],
  ['Kumho', 'kumho.png', 225, -0.04, -0.12],
];
---

<section class="brand-ticker" aria-label="Marcas de neumáticos disponibles">
  <div class="brand-ticker__meta" aria-hidden="true">
    <span>CYL / MULTIMARCA</span>
    <i></i>
    <span>12 MARCAS</span>
  </div>
  <div class="brand-ticker__viewport">
    <div class="brand-ticker__track">
      {[0, 1].map((copy) => (
        <div class="brand-ticker__group" aria-hidden={copy === 1}>
          {brands.map(([name, file, width, x, y]) => (
            <div class="brand-ticker__item" style={`--logo-width: ${width}px; --logo-x: ${x}%; --logo-y: ${y}%`}>
              <OptimizedImage src={`${base}images/brand-ticker/${file}`} alt={copy === 0 ? String(name) : ''} sizes={`${width}px`} loading="lazy" decoding="async" />
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
