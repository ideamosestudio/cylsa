---
import OptimizedImage from './OptimizedImage.astro';
import ArrowIcon from './ArrowIcon.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<footer class="site-footer site-footer--premium" id="footer">
  <div class="footer-topline">
    <span>CYL / PATAGONIA</span><span>NEUQUÉN · AÑELO</span><span>38.95° S / 68.06° W</span>
    <a class="footer-return" href="#" aria-label="Volver al inicio de la página" title="Volver arriba">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 20V5m-7 7 7-7 7 7"/>
      </svg>
    </a>
  </div>
  <div class="footer-main">
    <div class="footer-brand" data-reveal>
      <OptimizedImage src={`${base}logos/cyl-logo.png`} alt="CYL Neumáticos" width="200" height="68" loading="lazy" sizes="150px" />
      <h2>CONFIANZA EN<br /><span class="title-accent">CADA KILÓMETRO.</span></h2>
    </div>
    <div class="footer-nav-group">
      <span>SOBRE CYL</span>
      <a href={`${base}quienes-somos/`}>Quiénes somos</a><a href={`${base}nuestra-politica/`}>Nuestra política</a><a href={`${base}forma-parte-de-nuestro-equipo/`}>Trabajá con nosotros</a><a href={`${base}contacto/`}>Contacto</a>
    </div>
    <div class="footer-nav-group">
      <span>ATENCIÓN AL CLIENTE</span>
      <a class="footer-action" href={`${base}cotizacion/`}><span>Pedir cotización</span></a>
      <a class="footer-service" href="tel:+542994400914"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m5 3 4 1 1 5-2 2a15 15 0 0 0 5 5l2-2 5 1 1 4c-1 7-19-2-18-14z"/></svg>Llamar</a>
      <a class="footer-service" href={`${base}#sucursales`}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>Ver sucursales</a>
      <div class="footer-survey"><p>¿Cómo fue tu visita?</p><a href={`${base}encuesta-de-satisfaccion/`}>Contanos tu experiencia <ArrowIcon /></a></div>
    </div>
  </div>
  <div class="footer-bottom footer-bottom--premium">
    <p>© {new Date().getFullYear()} CYL S.A. Neumáticos</p>
    <div class="studio-credit">
      <span>Esta web salió del taller de</span>
      <a href="https://ideamos.com.ar/" aria-label="Visitar el sitio de Estudio Ideamos">
        <OptimizedImage src={`${base}logos/ideamos-light.webp`} alt="Estudio Ideamos" width="870" height="213" loading="lazy" sizes="112px" />
      </a>
    </div>
  </div>
</footer>
