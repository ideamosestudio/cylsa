    {locations.map((location) => (
      <address class="location" data-reveal><span>Sucursal {location.n}</span><h3>{location.address}</h3><p>{location.city}</p><div class="location-phones">{location.phones.map(([label, phone]) => <a href={`tel:${phone}`}>{label}</a>)}</div></address>
    ))}
  </div>
  <div class="footer-bottom">
    <div><span>Horario</span><p>Lunes a viernes, 8:30 a 17:30.<br />Sábados, 8:30 a 13:00.</p></div>
