---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<footer class="site-footer site-footer--premium" id="footer">
  <div class="footer-topline"><span>CYL / PATAGONIA</span><span>NEUQUÉN · AÑELO</span><span>38.95° S / 68.06° W</span></div>
  <div class="footer-main">
    <div class="footer-brand" data-reveal>
      <img src={`${base}logos/cyl-logo.png`} alt="CYL Neumáticos" width="200" height="68" />
      <h2>CONFIANZA EN<br /><span class="title-accent">CADA KILÓMETRO.</span></h2>
    </div>
    <div class="footer-nav-group">
      <span>EXPLORAR</span>
      <a href={base}>Productos</a><a href={base}>Marcas</a><a href={base}>Contacto</a><a href={base}>Sucursales</a>
    </div>
    <div class="footer-nav-group">
      <span>ACCIÓN</span>
      <a href={base}>Pedir cotización ↗</a>
      <a href={base}>Llamar ahora ↗</a>
      <a href={base}>Sitio institucional ↗</a>
    </div>
  </div>
  <div class="footer-bottom footer-bottom--premium"><p>© {new Date().getFullYear()} CYL S.A. Neumáticos</p><a href={base}>Volver arriba ↑</a><a href="https://www.ideamos.com.ar/" target="_blank" rel="noreferrer">Diseño y desarrollo / Estudio Ideamos</a></div>
</footer>
