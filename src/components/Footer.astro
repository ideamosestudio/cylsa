  { n: '02', address: 'Ingeniero Huergo 2554', city: 'Pin Oeste, Neuquén', phones: [['(0299) 5470059', '+542995470059'], ['(0299) 6562386', '+542996562386']] },
  { n: '03', address: 'Lote 11 – Frac. C, Manzana 35', city: 'Añelo, Neuquén', phones: [['(0299) 5483985', '+542995483985'], ['(0299) 540047', '+54299540047']] },
