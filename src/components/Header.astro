---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<header class="site-header" aria-label="Navegación principal" data-site-header>
  <div class="site-header__shell">
    <a class="site-logo" href={base} aria-label="CYL Neumáticos, inicio">
      <img src={`${base}logos/cyl-logo.png`} alt="CYL Neumáticos" width="200" height="68" />
    </a>
    <nav class="site-nav" aria-label="Secciones">
      <div class="site-nav__products">
        <a href={`${base}nuestros-neumaticos/`}><small>01</small><span>Nuestros neumáticos</span><b aria-hidden="true">⌄</b></a>
        <div class="site-nav__submenu" aria-label="Líneas de neumáticos">
          <a href={`${base}automovil/`}><small>01</small><span>Automóvil</span></a>
          <a href={`${base}camioneta/`}><small>02</small><span>Camioneta</span></a>
          <a href={`${base}transporte/`}><small>03</small><span>Transporte</span></a>
          <a href={`${base}agro-vial/`}><small>04</small><span>Agro / Vial</span></a>
        </div>
      </div>
      <a href={`${base}quienes-somos/`}><small>02</small><span>Quiénes somos</span></a>
      <a href={`${base}nuestra-politica/`}><small>03</small><span>Política</span></a>
      <a href={`${base}forma-parte-de-nuestro-equipo/`}><small>04</small><span>Equipo</span></a>
      <a href={`${base}contacto/`}><small>05</small><span>Contacto</span></a>
      <a class="nav-quote" href={`${base}cotizacion/`}><small>06</small><span>Cotización</span><b aria-hidden="true">↗</b></a>
    </nav>
    <span class="header-index" aria-hidden="true"><i></i><span>NQN</span><b>38.95° S</b></span>
    <button class="site-nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation">
      <span>MENÚ</span><i></i><i></i>
    </button>
  </div>
  <nav class="site-mobile-nav" id="mobile-navigation" aria-label="Navegación móvil" aria-hidden="true" inert>
    <span class="site-mobile-nav__meta">CYL / NQN / 38.95° S</span>
    <details class="site-mobile-nav__products">
      <summary><small>01</small><span>Nuestros neumáticos</span><b aria-hidden="true">⌄</b></summary>
      <div>
        <a href={`${base}nuestros-neumaticos/`}><small>00</small><span>Ver todas las líneas</span><b>↗</b></a>
        <a href={`${base}automovil/`}><small>01</small><span>Automóvil</span><b>↗</b></a>
        <a href={`${base}camioneta/`}><small>02</small><span>Camioneta</span><b>↗</b></a>
        <a href={`${base}transporte/`}><small>03</small><span>Transporte</span><b>↗</b></a>
        <a href={`${base}agro-vial/`}><small>04</small><span>Agro / Vial</span><b>↗</b></a>
      </div>
    </details>
    <a href={`${base}quienes-somos/`}><small>02</small><span>Quiénes somos</span><b>↗</b></a>
    <a href={`${base}nuestra-politica/`}><small>03</small><span>Nuestra política</span><b>↗</b></a>
    <a href={`${base}forma-parte-de-nuestro-equipo/`}><small>04</small><span>Trabajá con nosotros</span><b>↗</b></a>
    <a href={`${base}contacto/`}><small>05</small><span>Contacto</span><b>↗</b></a>
    <a class="site-mobile-nav__primary" href={`${base}cotizacion/`}><small>06</small><span>Solicitar cotización</span><b>↗</b></a>
  </nav>
</header>

<script>
  document.querySelectorAll<HTMLElement>('[data-site-header]').forEach((header) => {
    const toggle = header.querySelector<HTMLButtonElement>('.site-nav-toggle');
    const menu = header.querySelector<HTMLElement>('.site-mobile-nav');
    if (!toggle || !menu) return;
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      menu.setAttribute('aria-hidden', String(!open));
      menu.toggleAttribute('inert', !open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setOpen(false); });
  });
</script>
