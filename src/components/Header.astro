---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<header class="site-header" aria-label="Navegación principal" data-site-header>
  <div class="site-header__shell">
    <a class="site-logo" href={base} aria-label="CYL Neumáticos, inicio">
      <img src={`${base}logos/cyl-logo.png`} alt="CYL Neumáticos" width="200" height="68" />
    </a>
    <nav class="site-nav" aria-label="Secciones">
      <div class="site-nav__products">
        <a href={`${base}nuestros-neumaticos/`}><small>01</small><span>Nuestros neumáticos</span><b aria-hidden="true">⌄</b></a>
        <div class="site-nav__mega" aria-label="Líneas de neumáticos">
          <div class="site-nav__mega-heading">
            <span>CYL / LÍNEAS DE NEUMÁTICOS</span>
            <a href={`${base}nuestros-neumaticos/`}>Ver todas las líneas</a>
          </div>
          <div class="site-nav__mega-grid">
            <a class="site-nav__mega-card" href={`${base}automovil/`}>
              <span><small>01</small> Precisión y confort</span>
              <strong>Automóvil</strong>
              <img src={`${base}images/products/automovil.png`} alt="" width="460" height="259" />
            </a>
            <a class="site-nav__mega-card" href={`${base}camioneta/`}>
              <span><small>02</small> Tracción y libertad</span>
              <strong>Camioneta</strong>
              <img src={`${base}images/products/camioneta.png`} alt="" width="460" height="259" />
            </a>
            <a class="site-nav__mega-card" href={`${base}transporte/`}>
              <span><small>03</small> Resistencia continua</span>
              <strong>Transporte</strong>
              <img src={`${base}images/products/transporte.png`} alt="" width="460" height="259" />
            </a>
            <a class="site-nav__mega-card" href={`${base}agro-vial/`}>
              <span><small>04</small> Potencia y trabajo</span>
              <strong>Agro / Vial</strong>
              <img src={`${base}images/products/agro-vial.png`} alt="" width="460" height="259" />
            </a>
          </div>
        </div>
      </div>
      <div class="site-nav__about">
        <button class="site-nav__group-trigger" type="button" aria-haspopup="true"><small>02</small><span>Sobre nosotros</span><b aria-hidden="true">⌄</b></button>
        <div class="site-nav__submenu" aria-label="Sobre nosotros">
          <a href={`${base}quienes-somos/`}><small>01</small><span>Quiénes somos</span></a>
          <a href={`${base}nuestra-politica/`}><small>02</small><span>Política</span></a>
          <a href={`${base}forma-parte-de-nuestro-equipo/`}><small>03</small><span>Equipo</span></a>
        </div>
      </div>
      <a href={`${base}contacto/`}><small>03</small><span>Contacto</span></a>
      <a class="nav-quote" href={`${base}cotizacion/`}><small>04</small><span>Cotización</span></a>
    </nav>
    <span class="header-index" aria-hidden="true"><i></i><span>NQN</span><b>38.95° S</b></span>
    <button class="site-nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation">
      <span>MENÚ</span><i></i><i></i>
    </button>
  </div>
  <nav class="site-mobile-nav" id="mobile-navigation" aria-label="Navegación móvil" aria-hidden="true" inert>
    <span class="site-mobile-nav__meta">CYL / NQN / 38.95° S</span>
    <div class="site-mobile-nav__group">
      <a class="site-mobile-nav__heading" href={`${base}nuestros-neumaticos/`}><small>01</small><span>Nuestros neumáticos</span></a>
      <div class="site-mobile-nav__subnav">
        <a href={`${base}automovil/`}><small>01</small><span>Automóvil</span></a>
        <a href={`${base}camioneta/`}><small>02</small><span>Camioneta</span></a>
        <a href={`${base}transporte/`}><small>03</small><span>Transporte</span></a>
        <a href={`${base}agro-vial/`}><small>04</small><span>Agro / Vial</span></a>
      </div>
    </div>
    <div class="site-mobile-nav__group">
      <p class="site-mobile-nav__heading"><small>02</small><span>Sobre nosotros</span></p>
      <div class="site-mobile-nav__subnav">
        <a href={`${base}quienes-somos/`}><small>01</small><span>Quiénes somos</span></a>
        <a href={`${base}nuestra-politica/`}><small>02</small><span>Nuestra política</span></a>
        <a href={`${base}forma-parte-de-nuestro-equipo/`}><small>03</small><span>Equipo</span></a>
      </div>
    </div>
    <a href={`${base}contacto/`}><small>03</small><span>Contacto</span></a>
    <a class="site-mobile-nav__primary" href={`${base}cotizacion/`}><small>04</small><span>Solicitar cotización</span></a>
  </nav>
</header>

<script>
  document.querySelectorAll<HTMLElement>('[data-site-header]').forEach((header) => {
    const toggle = header.querySelector<HTMLButtonElement>('.site-nav-toggle');
    const menu = header.querySelector<HTMLElement>('.site-mobile-nav');
    if (!toggle || !menu) return;
    const updateScrolledState = () => header.classList.toggle('is-scrolled', window.scrollY > 16);
    updateScrolledState();
    window.addEventListener('scroll', updateScrolledState, { passive: true });
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-menu-open', open);
      document.documentElement.classList.toggle('has-site-menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      menu.setAttribute('aria-hidden', String(!open));
      menu.toggleAttribute('inert', !open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setOpen(false); });
  });
</script>
