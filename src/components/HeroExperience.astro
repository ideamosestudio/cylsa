---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<section class="hero-track" id="hero-track" aria-labelledby="hero-title">
  <div class="hero-sticky" id="inicio">
    <div class="hero-background" style={`--hero-image: url('${base}images/automovil.webp')`}></div>
    <canvas id="tire-canvas" aria-label="Visualización tridimensional de un neumático técnico desmontable"></canvas>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-copy">
      <p class="eyebrow">CYL NEUMÁTICOS / NEUQUÉN</p>
      <h1 id="hero-title"><span>El camino</span><span>no se detiene.</span></h1>
      <p class="hero-intro">Soluciones en neumáticos para cada camino, cada terreno y cada desafío.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#universos">Explorar nuestras líneas</a>
        <a class="button button-secondary" href="https://crm.autopartespro.com/BudgetRequest/taller/cyl-neumaticos/normal" target="_blank" rel="noreferrer">Pedí tu cotización</a>
      </div>
    </div>
    <div class="hero-tech hero-tech-left" aria-hidden="true"><span>Secuencia</span><strong id="hero-step">00 / 04</strong></div>
    <div class="hero-tech hero-tech-right" aria-hidden="true"><span>Compuesto</span><strong>Rubber / PBR</strong></div>
    <div class="hero-progress-wrap" aria-hidden="true"><span>Deslizá para descubrir</span><div class="hero-progress-line"><i id="hero-progress"></i></div></div>
    <p class="hero-claim">Confianza en cada kilómetro.</p>
    <div class="webgl-fallback" aria-hidden="true">CYL</div>
  </div>
</section>
