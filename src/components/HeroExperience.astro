---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<section class="hero-track" id="hero-track" aria-labelledby="hero-title">
  <div class="hero-sticky" id="inicio">
    <div class="car-scene" aria-hidden="true">
      <img src={`${base}images/hero-suv.png`} alt="" width="1792" height="1024" fetchpriority="high" />
    </div>
    <div class="cinematic-shade" aria-hidden="true"></div>
    <div class="wheel-focus" aria-hidden="true">
      <div class="wheel-crop"><img src={`${base}images/hero-suv.png`} alt="" width="1792" height="1024" /></div>
      <i class="engineering-ring ring-a"></i>
      <i class="engineering-ring ring-b"></i>
      <i class="engineering-ring ring-c"></i>
      <i class="engineering-axis"></i>
    </div>
    <div class="hero-copy">
      <p class="hero-eyebrow">CYL NEUMÁTICOS / NEUQUÉN</p>
      <h1 id="hero-title">EL CAMINO<br />NO SE DETIENE.</h1>
      <p class="hero-intro">Soluciones en neumáticos para cada camino, cada terreno y cada desafío.</p>
      <div class="hero-actions">
        <a class="hero-cta hero-cta-primary" href="#universos">EXPLORAR NUESTRAS LÍNEAS <b>↓</b></a>
        <a class="hero-cta hero-cta-secondary" href="https://crm.autopartespro.com/BudgetRequest/taller/cyl-neumaticos/normal" target="_blank" rel="noreferrer">PEDÍ TU COTIZACIÓN <b>↗</b></a>
      </div>
    </div>
    <div class="hero-status" aria-hidden="true">
      <span id="hero-step">00 / 04</span>
      <p>SECUENCIA TÉCNICA<br />RUEDA DELANTERA</p>
    </div>
    <div class="hero-progress" aria-hidden="true"><i id="hero-progress"></i></div>
    <p class="hero-claim">CONFIANZA EN CADA KILÓMETRO.</p>
  </div>
</section>
