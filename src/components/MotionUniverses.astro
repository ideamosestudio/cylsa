---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const categories = [
  { n: '01', title: 'Automóvil', feeling: 'Precisión y confort', image: 'automovil.webp' },
  { n: '02', title: 'Camioneta', feeling: 'Tracción y libertad', image: 'camioneta.webp' },
  { n: '03', title: 'Transporte', feeling: 'Resistencia continua', image: 'transporte.webp' },
  { n: '04', title: 'Agro / Vial', feeling: 'Potencia y trabajo', image: 'agro-vial.webp' },
];
---
<section class="universes" id="universos" aria-labelledby="universes-title">
  <div class="section-intro" data-reveal>
    <p class="eyebrow">04 universos / infinitos caminos</p>
    <div class="section-title-row"><h2 id="universes-title">No todos los caminos<br />son iguales.</h2><p>De la ciudad a los terrenos más exigentes. Soluciones para cada forma de moverse.</p></div>
  </div>
  <div class="universe-grid">
    {categories.map((item) => (
      <article class="universe-card" data-reveal>
        <img src={`${base}images/${item.image}`} alt={`Escena de ${item.title.toLowerCase()} en movimiento`} loading="lazy" width="1536" height="1024" />
        <div class="card-shade"></div><div class="card-number">{item.n}</div>
        <div class="card-copy"><p>{item.feeling}</p><h3>{item.title}</h3><a href="#sucursales" aria-label={`Consultar neumáticos para ${item.title}`}>Consultar línea</a></div>
      </article>
    ))}
  </div>
</section>
