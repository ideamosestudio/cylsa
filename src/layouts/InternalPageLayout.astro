---
import '../styles/global.css';
import '../styles/home-premium.css';
import '../styles/internal-pages.css';
import '../styles/button-system.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloatingButton from '../components/WhatsAppFloatingButton.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  accent?: string;
  intro: string;
  showHero?: boolean;
  heroImage?: string;
  heroImageAlt?: string;
  heroIndex?: string;
  heroApplication?: string;
  heroProfile?: string;
  singleLineHeroTitle?: boolean;
}

const {
  title,
  description,
  eyebrow,
  heading,
  accent,
  intro,
  showHero = true,
  heroImage,
  heroImageAlt = '',
  heroIndex = '01',
  heroApplication = 'MULTIPROPÓSITO',
  heroProfile = 'RENDIMIENTO + CONTROL',
  singleLineHeroTitle = false,
} = Astro.props;
const isProductHero = Boolean(heroImage);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080808" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title} — CYL Neumáticos</title>
  </head>
  <body class={`internal-page${showHero ? '' : ' internal-page--no-hero'}${singleLineHeroTitle ? ' internal-page--single-line-title' : ''}`}>
    <Header />
    <main>
      {showHero && (
        <section class={`internal-hero${isProductHero ? ' internal-hero--product' : ''}`}>
          <div class="internal-hero__glow" aria-hidden="true"></div>
          <div class="internal-hero__grid" aria-hidden="true"></div>
          {isProductHero && (
            <>
              <div class="internal-product-frame" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
              <div class="internal-product-orbit" aria-hidden="true">
                <i></i><i></i><i></i><span>CYL / PRODUCT SYSTEM</span>
              </div>
              <div class="internal-product-visual">
                <img src={`${base}images/product-heroes/${heroImage}`} alt={heroImageAlt} width="1280" height="1280" fetchpriority="high" />
              </div>
              <div class="internal-product-readout" aria-hidden="true">
                <span>{heroIndex} / 04</span><i></i><strong>{heading}</strong>
              </div>
              <div class="internal-product-note" aria-hidden="true">
                <i></i><span>CYL PRODUCT SERIES<br /><strong>{heading}</strong></span>
              </div>
              <div class="internal-product-side-code" aria-hidden="true">CYL—NQN&nbsp;&nbsp;/&nbsp;&nbsp;38.95°S&nbsp;&nbsp;/&nbsp;&nbsp;068.06°W</div>
              <div class="internal-product-specs" aria-hidden="true">
                <span><small>APLICACIÓN</small><strong>{heroApplication}</strong></span>
                <span><small>PERFIL</small><strong>{heroProfile}</strong></span>
                <span><small>LÍNEA</small><strong>{heading} / {heroIndex}</strong></span>
              </div>
            </>
          )}
          <div class="internal-hero__content">
            <p class="internal-kicker"><span>CYL</span> {eyebrow}</p>
            <h1><span>{heading}</span>{accent && <em class="animated-title">{accent}</em>}</h1>
            <p class="internal-hero__intro">{intro}</p>
            <div class="internal-hero__actions">
              <a class="button button--ghost" href="https://wa.me/5492994082513" target="_blank" rel="noopener noreferrer" aria-label="Solicitar cotización por WhatsApp">
                Solicitar cotización
              </a>
            </div>
          </div>
          <div class="internal-hero__meta" aria-hidden="true"><span>PATAGONIA / ARG</span><i></i><span>38.95° S</span></div>
        </section>
      )}
      <slot />
    </main>
    <Footer />
    <WhatsAppFloatingButton />

    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        }, { threshold: .12 });
        document.querySelectorAll<HTMLElement>('[data-page-reveal]').forEach((element) => observer.observe(element));
      } else {
        document.querySelectorAll<HTMLElement>('[data-page-reveal]').forEach((element) => element.classList.add('is-visible'));
      }

      const branchNumbers: Record<string, string> = {
        perticone: '5492995470052',
        pin: '5492995470059',
        anelo: '5492995483985',
      };

      document.querySelectorAll<HTMLFormElement>('[data-whatsapp-form]').forEach((form) => {
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          if (!form.reportValidity()) return;
          const data = new FormData(form);
          const branch = String(data.get('sucursal') || 'perticone');
          const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[data-message-label]'));
          const lines = fields.flatMap((field) => {
            const value = field instanceof HTMLSelectElement ? field.selectedOptions[0]?.text.trim() : field.value.trim();
            return value ? [`${field.dataset.messageLabel}: ${value}`] : [];
          });
          const heading = form.dataset.messageHeading || 'Consulta desde la web de CYL';
          const message = [heading, '', ...lines].join('\n');
          window.open(`https://wa.me/${branchNumbers[branch] || branchNumbers.perticone}?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
        });
      });

      document.querySelectorAll<HTMLFormElement>('[data-mail-form]').forEach((form) => {
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          if (!form.reportValidity()) return;
          const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[data-message-label]'));
          const lines = fields.flatMap((field) => {
            const value = field instanceof HTMLSelectElement ? field.selectedOptions[0]?.text.trim() : field.value.trim();
            return value ? [`${field.dataset.messageLabel}: ${value}`] : [];
          });
          const subject = form.dataset.mailSubject || 'Contacto desde la web de CYL';
          window.location.href = `mailto:${form.dataset.mailTo}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
        });
      });
    </script>
  </body>
</html>
