---
import SeoHead from '../components/SeoHead.astro';
import { siteUrl } from '../../site.config.mjs';
import OptimizedImage from '../components/OptimizedImage.astro';
import '../styles/global.css';
import '../styles/home-premium.css';
import '../styles/product-detail.css';
import '../styles/button-system.css';
import Header from '../components/Header.astro';
import ContactSuite from '../components/ContactSuite.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloatingButton from '../components/WhatsAppFloatingButton.astro';

interface ProductImage {
  src: string;
  alt: string;
  label: string;
}

interface ProductSize {
  measure: string;
  speed: string;
}

interface Props {
  title: string;
  model: string;
  variant: string;
  category: string;
  categoryHref: string;
  brand: string;
  brandLogo?: string;
  series?: string;
  description: string;
  coverIntro?: string;
  storyTitle?: string;
  storyAccent?: string;
  claim?: string;
  micro?: string;
  segment?: string;
  surface?: string;
  maxSpeed?: string;
  heroImage: string;
  heroImageAlt: string;
  gallery: ProductImage[];
  performance: string[];
  uses: string[];
  speeds: string[];
  recommendations: string[];
  sizes: ProductSize[];
}

const {
  title,
  model,
  variant,
  category,
  categoryHref,
  brand,
  brandLogo,
  series = 'PREMIUM SERIES',
  description,
  coverIntro = 'Diseño, eficiencia y control para una conducción más segura y confortable.',
  storyTitle = 'DISEÑO ITALIANO.',
  storyAccent = 'EVOLUCIÓN REAL.',
  claim = 'HECHA PARA AVANZAR.',
  micro = `${brand} / ${model} / PAVIMENTO`,
  segment = 'PREMIUM',
  surface = 'PAVIMENTO',
  maxSpeed = 'CONSULTAR',
  heroImage,
  heroImageAlt,
  gallery,
  performance,
  uses,
  speeds,
  recommendations,
  sizes,
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (path: string) => `${base}${path.replace(/^\//, '')}`;
const productName = `${model} ${variant}`.trim();
const claimParts = claim.trim().split(/\s+/);
const claimAccent = claimParts.pop() ?? '';
const claimLead = claimParts.join(' ');
const whatsapp = (intent: string) => `https://wa.me/5492994082513?text=${encodeURIComponent(`Hola, ${intent} ${productName}.`)}`;
---

<!doctype html>
<html lang="es">
  <head>
    <SeoHead title={title + ' | CYL Neumáticos'} description={description} image={heroImage} schema={[
      { '@type': 'Product', '@id': new URL(Astro.url.pathname, Astro.site).href + '#product', name: title, description, image: new URL(heroImage, siteUrl).href, brand: { '@type': 'Brand', name: brand }, category, url: new URL(Astro.url.pathname, Astro.site).href },
      { '@type': 'BreadcrumbList', itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: category, item: new URL(categoryHref, siteUrl).href },
        { '@type': 'ListItem', position: 3, name: title, item: new URL(Astro.url.pathname, Astro.site).href }
      ] }
    ]} />
  </head>
  <body class="product-detail-page">
    <Header />
    <main id="contenido">
      <section class="product-story" aria-label={`Presentación y ficha técnica de ${productName}`}>
      <div class="product-cover" aria-labelledby="product-title">
        <div class="product-cover__grid" aria-hidden="true"></div>
        <div class="product-cover__glow" aria-hidden="true"></div>
        <div class="product-cover__orbit" aria-hidden="true"><i></i><i></i><i></i><span>CYL / PRODUCT SYSTEM</span></div>
        <div class="product-cover__frame" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

        <div class="product-cover__copy">
          <a class="product-breadcrumb" href={`${base}${categoryHref}`}><span>01</span> PRODUCTOS / {category}</a>
          <div class="product-brand">
            {brandLogo ? <OptimizedImage src={asset(brandLogo)} alt={brand} width="1254" height="1254" /> : <strong>{brand}</strong>}
            <span>{series}</span>
          </div>
          <h1 id="product-title"><span>{model}</span>{variant && <em class="animated-title">{variant}</em>}</h1>
          <p class="product-cover__intro">{coverIntro}</p>
          <div class="product-cover__actions">
            <a class="button button-primary" href={whatsapp('quiero solicitar una cotización por')} target="_blank" rel="noopener noreferrer">Solicitar cotización</a>
            <a class="button button-secondary" href="#medidas">Ver medidas</a>
          </div>
        </div>

        <div class="product-cover__visual">
          <OptimizedImage src={asset(heroImage)} alt={heroImageAlt} width="640" height="640" fetchpriority="high" />
        </div>

        <div class="product-cover__readout" aria-hidden="true"><span>01 / 01</span><i></i><strong>FICHA DE PRODUCTO</strong></div>
        <div class="product-cover__side" aria-hidden="true">CYL—NQN / 38.95°S / 068.06°W</div>
        <div class="product-cover__specs" aria-hidden="true">
          <span><small>SEGMENTO</small><strong>{segment}</strong></span>
          <span><small>SUPERFICIE</small><strong>{surface}</strong></span>
          <span><small>VELOCIDAD</small><strong>HASTA {maxSpeed}</strong></span>
        </div>
      </div>

      <div class="product-facts product-facts--merged product-section" data-product-reveal data-code="CYL / DESIGN + TECHNICAL DATA">
        <div class="product-shell">
          <div class="product-facts__intro">
            <div class="product-facts__headline">
              <p class="product-facts__title-eyebrow">{brand} / {model} {variant}</p>
              <h2>{storyTitle}<br /><em class="title-accent">{storyAccent}</em></h2>
              <p class="product-facts__micro">{micro}</p>
            </div>
            <div class="product-facts__summary">
              <span class="product-facts__summary-index" aria-hidden="true">01 — 05</span>
              <p class="product-facts__claim">{claimLead} <em>{claimAccent}</em></p>
              <p>{description}</p>
              <div class="product-overview__stamp" aria-label={`${brand}, línea premium`}>
                {brandLogo ? <OptimizedImage src={asset(brandLogo)} alt={brand} width="1254" height="1254" loading="lazy" /> : <span>{brand}</span>}
                <strong>PREMIUM<br />PERFORMANCE</strong>
              </div>
              <a class="product-inline-cta product-inline-cta--dark" href={whatsapp('quiero recibir más información sobre')} target="_blank" rel="noopener noreferrer">Quiero más info</a>
            </div>
          </div>
          <div class="product-facts__grid">
            <article>
              <div class="product-fact-icon" aria-hidden="true">
                <svg viewBox="0 0 48 48"><path d="M8 34a18 18 0 1 1 32 0" /><path d="m24 25 11-8" /><circle cx="24" cy="25" r="3" /><path d="M13 34h22" /></svg>
              </div>
              <h3>PRESTACIONES</h3>
              <ul>{performance.map((item) => <li>{item}</li>)}</ul>
            </article>
            <article>
              <div class="product-fact-icon" aria-hidden="true">
                <svg viewBox="0 0 48 48"><path d="M17 42 21 6h6l4 36" /><path d="M24 9v7m0 7v7m0 7v5" /><path d="M8 42h32" /></svg>
              </div>
              <h3>USOS</h3>
              <ul>{uses.map((item) => <li>{item}</li>)}</ul>
            </article>
            <article>
              <div class="product-fact-icon" aria-hidden="true">
                <svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18" /><path d="M8 24h5m22 0h5M24 8v5" /><path d="m24 24 9-7" /><circle cx="24" cy="24" r="2.5" /></svg>
              </div>
              <h3>VELOCIDADES</h3>
              <ul>{speeds.map((item) => <li>{item}</li>)}</ul>
            </article>
            <article>
              <div class="product-fact-icon" aria-hidden="true">
                <svg viewBox="0 0 48 48"><path d="M24 5 39 11v11c0 10-6 17-15 21-9-4-15-11-15-21V11Z" /><path d="m16 24 5 5 11-12" /></svg>
              </div>
              <h3>RECOMENDACIONES</h3>
              <ul>{recommendations.map((item) => <li>{item}</li>)}</ul>
            </article>
            <article>
              <div class="product-fact-icon" aria-hidden="true">
                <svg viewBox="0 0 48 48"><path d="M8 34 34 8l6 6-26 26Z" /><path d="m29 13 6 6m-12 0 4 4m-10 2 4 4m-10 2 4 4" /></svg>
              </div>
              <h3>MEDIDAS</h3>
              <ul>{sizes.map((size) => <li>{size.measure} / RANGO {size.speed}</li>)}</ul>
            </article>
          </div>
        </div>
      </div>

      <div class="product-gallery product-section" aria-label="Vistas del neumático" data-product-reveal>
        <div class="product-gallery__top product-shell">
          <p class="product-section__label">03 / PRODUCT VIEW</p>
          <p>FORMA, PISADA Y PERFIL<br />DESDE TODOS LOS ÁNGULOS.</p>
        </div>
        <div class="product-gallery__grid product-shell">
          {gallery.map((image, index) => (
            <figure>
              <span>0{index + 1}</span>
              <OptimizedImage src={asset(image.src)} alt={image.alt} width="640" height="640" loading="lazy" />
              <figcaption>{image.label}</figcaption>
            </figure>
          ))}
        </div>
      </div>

      <div class="product-sizes product-section" id="medidas" data-product-reveal>
        <div class="product-shell product-sizes__layout">
          <div class="product-sizes__heading">
            <p class="product-section__label">04 / MEDIDAS DISPONIBLES</p>
            <h2>ENCONTRÁ TU<br /><em class="title-accent">MEDIDA.</em></h2>
            <p class="product-sizes__description">Versiones homologadas para distintas configuraciones de llanta y desempeño.</p>
            <a class="product-inline-cta product-inline-cta--red" href={whatsapp('quiero recibir más información sobre')} target="_blank" rel="noopener noreferrer">Quiero más info</a>
          </div>
          <div class="product-sizes__list">
            {sizes.map((size, index) => (
              <div><span>0{index + 1}</span><strong>{size.measure}</strong><small>RANGO {size.speed}</small></div>
            ))}
          </div>
        </div>
      </div>
      </section>

      <section class="product-care product-section" data-product-reveal data-code="CYL / SERVICE PROTOCOL">
        <div class="product-shell product-care__grid">
          <div>
            <p class="product-section__label">05 / RECOMENDACIONES</p>
            <h2>CUIDÁ EL RENDIMIENTO.<br /><em class="title-accent title-accent--light">CUIDÁ TU CAMINO.</em></h2>
            <a class="product-inline-cta product-inline-cta--red product-care__cta" href={whatsapp('quiero consultar a un experto sobre')} target="_blank" rel="noopener noreferrer">Consultar a un experto</a>
          </div>
          <div>
            <ol>{recommendations.map((item) => <li>{item}</li>)}</ol>
          </div>
        </div>
      </section>
      <ContactSuite />
    </main>
    <Footer />
    <WhatsAppFloatingButton />

    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) {
        document.querySelectorAll<HTMLElement>('[data-product-reveal]').forEach((element) => element.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        }, { threshold: .1 });
        document.querySelectorAll<HTMLElement>('[data-product-reveal]').forEach((element) => observer.observe(element));
      }
    </script>
  </body>
</html>
