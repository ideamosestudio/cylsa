---
import ProductPageLayout from '../layouts/ProductPageLayout.astro';
import { additionalAutomovilProducts, type AutomovilProduct } from '../data/automovil-products';
import { camionetaProducts } from '../data/camioneta-products';
import { transporteProducts } from '../data/transporte-products';
import { agroVialProducts } from '../data/agro-vial-products';

export function getStaticPaths() {
  return [
    ...additionalAutomovilProducts.map((product) => ({
      params: { product: product.slug },
      props: { product, category: 'AUTOMÓVIL', categoryHref: 'automovil/' },
    })),
    ...camionetaProducts.map((product) => ({
      params: { product: product.slug },
      props: { product, category: 'CAMIONETA', categoryHref: 'camioneta/' },
    })),
    ...transporteProducts.map((product) => ({
      params: { product: product.slug },
      props: { product, category: 'TRANSPORTE', categoryHref: 'transporte/' },
    })),
    ...agroVialProducts.map((product) => ({
      params: { product: product.slug },
      props: { product, category: 'AGRO / VIAL', categoryHref: 'agro-vial/' },
    })),
  ];
}

interface Props {
  product: AutomovilProduct;
  category: string;
  categoryHref: string;
}

const { product, category, categoryHref } = Astro.props;
---

<ProductPageLayout
  title={product.title}
  model={product.model}
  variant={product.variant}
  category={category}
  categoryHref={categoryHref}
  brand={product.brand}
  brandLogo={product.brandLogo}
  series={product.series}
  description={product.description}
  coverIntro={product.coverIntro}
  storyTitle={product.storyTitle}
  storyAccent={product.storyAccent}
  claim={product.claim}
  micro={product.micro}
  segment={product.segment}
  surface={product.surface}
  maxSpeed={product.maxSpeed}
  heroImage={product.heroImage}
  heroImageAlt={product.heroImageAlt}
  gallery={product.gallery}
  performance={product.performance}
  uses={product.uses}
  speeds={product.speeds}
  recommendations={product.recommendations}
  sizes={product.sizes}
/>
