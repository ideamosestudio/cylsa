---
import InternalPageLayout from '../layouts/InternalPageLayout.astro';
import '../styles/product-detail.css';
import { automovilProducts } from '../data/automovil-products';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<InternalPageLayout
  title="Automóvil"
  description="Neumáticos para automóvil en CYL Neumáticos."
  eyebrow="NUESTROS NEUMÁTICOS / 01"
  heading="AUTOMÓVIL"
  intro="Precisión, confort y seguridad para disfrutar cada kilómetro."
  heroImage="automovil.png"
  heroImageAlt="Neumático para automóvil con iluminación roja"
  heroIndex="01"
  heroApplication="URBANO / RUTA"
  heroProfile="PRECISIÓN + CONFORT"
>
  <section class="category-products" aria-labelledby="automovil-products-title">
    <div class="category-products__shell">
      <div class="category-products__heading">
        <div>
          <p>01 / MODELOS DISPONIBLES</p>
          <h2 id="automovil-products-title">NEUMÁTICOS PARA <em>AUTOMÓVIL.</em></h2>
        </div>
        <span>Ocho modelos para diferentes necesidades de confort, eficiencia, rendimiento y control.</span>
      </div>
      <div class="category-products__grid">
        {automovilProducts.map((product, index) => (
          <a class="category-product-card" href={`${base}${product.slug}/`} aria-label={`Ver ficha técnica de ${product.title}`}>
            <div class="category-product-card__visual">
              <span>0{index + 1}</span>
              <img src={`${base}${product.heroImage}`} alt={product.heroImageAlt} width="640" height="640" loading="lazy" />
            </div>
            <div class="category-product-card__copy">
              <span>{product.brand} / {product.segment}</span>
              <h3>{product.model}{product.cardVariant && <em>{product.cardVariant}</em>}</h3>
              <p>Ver ficha técnica <b>↗</b></p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</InternalPageLayout>
