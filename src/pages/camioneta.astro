---
import OptimizedImage from '../components/OptimizedImage.astro';
import InternalPageLayout from '../layouts/InternalPageLayout.astro';
import '../styles/product-detail.css';
import { camionetaProducts } from '../data/camioneta-products';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<InternalPageLayout
  title="Camioneta"
  description="Neumáticos para camioneta en CYL Neumáticos."
  eyebrow="NUESTROS NEUMÁTICOS / 02"
  heading="CAMIONETA"
  intro="Tracción y libertad para avanzar dentro y fuera del camino."
  heroImage="camioneta.png"
  heroImageAlt="Neumático para camioneta con iluminación roja"
  heroIndex="02"
  heroApplication="ON ROAD / OFF ROAD"
  heroProfile="TRACCIÓN + LIBERTAD"
>
  <section class="category-products" aria-label="Modelos de neumáticos para camioneta">
    <div class="category-products__shell">
      <div class="category-products__grid">
        {camionetaProducts.map((product, index) => (
          <a class="category-product-card" href={`${base}${product.slug}/`} aria-label={`Quiero ver el producto ${product.title}`}>
            <div class="category-product-card__visual">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <OptimizedImage src={`${base}${product.heroImage}`} alt={product.heroImageAlt} width="640" height="640" loading="lazy" />
            </div>
            <div class="category-product-card__copy">
              <div class="category-product-card__meta">
                <span>{product.brand} / {product.segment}</span>
                <OptimizedImage src={`${base}images/brands/fate-logo-black.png`} alt="Fate" width="1165" height="450" loading="lazy" />
              </div>
              <h3>{product.model}{product.cardVariant && <em>{product.cardVariant}</em>}</h3>
              <p>Quiero ver este producto</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</InternalPageLayout>
