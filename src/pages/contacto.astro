---
import InternalPageLayout from '../layouts/InternalPageLayout.astro';
const locations = [
  { n:'01', name:'Perticone', address:'Eugenio Perticone 1203', city:'Q8300 Neuquén', phones:[['(0299) 5470052','+542995470052'],['(0299) 6324963','+542996324963']] },
  { n:'02', name:'Pin Oeste', address:'Ingeniero Huergo 2554', city:'Q8300 Neuquén', phones:[['(0299) 5470059','+542995470059'],['(0299) 6562386','+542996562386']] },
  { n:'03', name:'Añelo', address:'Lote 11 – Frac. C, Manzana 35', city:'Añelo / Neuquén', phones:[['(0299) 5483985','+542995483985'],['(0299) 540047','+54299540047']] },
];
---

<InternalPageLayout
  title="Contacto"
  description="Contactá a CYL Neumáticos y encontrá nuestras sucursales en Neuquén y Añelo."
  eyebrow="CONTACTO / RESPUESTA DIRECTA"
  heading="HABLEMOS."
  accent="ESTAMOS CERCA."
  intro="Elegí tu sucursal y escribinos. Un integrante de nuestro equipo te ayudará a resolver tu consulta."
>
  <section class="page-section form-section">
    <div class="page-shell form-layout">
      <div class="form-side" data-page-reveal><p class="page-label">01 / ESCRIBINOS</p><h2>¿CÓMO PODEMOS<br /><em>AYUDARTE?</em></h2><p>Completá tus datos y continuá la conversación por WhatsApp con la sucursal que prefieras.</p><div class="form-direct"><a href="tel:+542994400914">0299 440-0914</a></div></div>
      <form class="internal-form" data-whatsapp-form data-message-heading="Hola, quiero hacer una consulta desde la web de CYL." data-page-reveal>
        <div class="internal-form__top"><span>FORM / CONTACTO</span><b>Respuesta por WhatsApp</b></div>
        <label>Nombre y apellido *<input type="text" name="nombre" autocomplete="name" required data-message-label="Nombre y apellido" /></label>
        <label>Teléfono *<input type="tel" name="telefono" autocomplete="tel" required data-message-label="Teléfono" /></label>
        <label>Email<input type="email" name="email" autocomplete="email" data-message-label="Email" /></label>
        <label>Sucursal *<select name="sucursal" required data-message-label="Sucursal"><option value="perticone">Neuquén / Perticone</option><option value="pin">Neuquén / Pin Oeste</option><option value="anelo">Añelo</option></select></label>
        <label class="internal-form__full">Consulta *<textarea name="mensaje" required placeholder="Contanos qué necesitás" data-message-label="Consulta"></textarea></label>
        <button type="submit"><span>Enviar por WhatsApp</span><span aria-hidden="true">↗</span></button>
        <p class="internal-form__note">Al continuar se abrirá WhatsApp con tu consulta lista para enviar.</p>
      </form>
    </div>
  </section>
  <section class="page-section page-section--light">
    <div class="page-shell">
      <div class="page-lead-grid" data-page-reveal><p class="page-label">02 / SUCURSALES</p><h2 class="page-display">TRES PUNTOS.<br /><em>UN MISMO SERVICIO.</em></h2></div>
      <div class="locations-grid">
        {locations.map((location) => <address class="location-card" data-page-reveal><span>{location.n} / {location.name}</span><h3>{location.address}</h3><p>{location.city}</p><div>{location.phones.map(([label, phone]) => <a href={`tel:${phone}`}>{label}</a>)}</div><small>Lun a Vie · 8:30 a 17:30<br />Sábados · 8:30 a 13:00</small></address>)}
      </div>
    </div>
  </section>
</InternalPageLayout>
