---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import { branchSchema } from '../data/branches';
import Header from '../components/Header.astro';
import HeroExperience from '../components/HeroSport.astro';
import MotionUniverses from '../components/MotionUniverses.astro';
import AdvisoryDrive from '../components/AdvisoryDrive.astro';
import BrandMatrix from '../components/BrandMatrix.astro';
import HomeDetails from '../components/HomeDetails.astro';
import ContactSuite from '../components/ContactSuite.astro';
import '../styles/advisory-drive.css';
import '../styles/brand-ticker.css';
import '../styles/home-premium.css';
import '../styles/button-system.css';
import Footer from '../components/Footer.astro';
import WhatsAppFloatingButton from '../components/WhatsAppFloatingButton.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="es">
  <head>
    <SeoHead title="Neumáticos en Neuquén y Añelo | CYL Neumáticos" description="Venta de neumáticos para automóvil, camioneta, transporte y agro/vial. Asesoramiento multimarca y tres sucursales en Neuquén y Añelo." schema={branchSchema} />
  </head>
  <body>
    <Header />
    <main id="contenido">
      <HeroExperience />
      <MotionUniverses />
      <AdvisoryDrive />
      <BrandMatrix />
      <HomeDetails />
      <ContactSuite />
    </main>
    <Footer />
    <WhatsAppFloatingButton />

    <script src="../scripts/home.ts"></script>
  </body>
</html>
