---
import '../styles/global.css';
import Header from '../components/Header.astro';
import HeroExperience from '../components/HeroExperience.astro';
import MotionUniverses from '../components/MotionUniverses.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="CYL Neumáticos. Neumáticos para automóvil, camioneta, transporte y agro/vial en Neuquén y Añelo." />
    <meta name="theme-color" content="#090a0c" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>CYL Neumáticos — El camino no se detiene</title>
  </head>
  <body>
    <Header />
    <main>
      <HeroExperience />
      <MotionUniverses />
    </main>
    <Footer />

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);
      const track = document.querySelector<HTMLElement>('#hero-track');
      const progress = document.querySelector<HTMLElement>('#hero-progress');
      const step = document.querySelector<HTMLElement>('#hero-step');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const clamp = (v: number, min = 0, max = 1) => Math.min(max, Math.max(min, v));
      const smooth = (v: number) => v * v * (3 - 2 * v);
      const updateHero = () => {
        if (!track) return;
        const distance = Math.max(1, track.offsetHeight - window.innerHeight);
        const p = reduced ? 0 : clamp(-track.getBoundingClientRect().top / distance);
        const approach = smooth(clamp((p - .18) / .25));
        const explodeIn = smooth(clamp((p - .48) / .18));
        const returnOut = smooth(clamp((p - .78) / .18));
        const focus = approach * (1 - returnOut);
        const explode = explodeIn * (1 - returnOut);
        track.style.setProperty('--hero-p', String(p));
        track.style.setProperty('--wheel-focus', String(focus));
        track.style.setProperty('--wheel-explode', String(explode));
        if (progress) progress.style.transform = `scaleX(${p})`;
        if (step) step.textContent = `${String(Math.min(4, Math.floor(p * 5))).padStart(2, '0')} / 04`;
      };

      updateHero();
      window.addEventListener('scroll', updateHero, { passive: true });
      window.addEventListener('resize', updateHero, { passive: true });

      if (!reduced) {
        gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((element) => {
          gsap.fromTo(element, { y: 54, opacity: 0 }, { y: 0, opacity: 1, duration: 1.05, ease: 'power3.out', scrollTrigger: { trigger: element, start: 'top 88%', once: true } });
        });
        gsap.utils.toArray<HTMLElement>('.route-image img').forEach((image) => {
          gsap.fromTo(image, { scale: 1.14 }, { scale: 1, ease: 'none', scrollTrigger: { trigger: image, start: 'top bottom', end: 'bottom top', scrub: 0.6 } });
        });
      }

      const header = document.querySelector('.site-header');
      const setHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 32);
      window.addEventListener('scroll', setHeader, { passive: true });
      setHeader();

      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
        link.addEventListener('click', (event) => {
          const target = document.querySelector(link.hash);
          if (!target) return;
          event.preventDefault();
          target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth' });
        });
      });
    </script>
  </body>
</html>
