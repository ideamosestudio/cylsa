---
import '../styles/global.css';
import Header from '../components/Header.astro';
import HeroExperience from '../components/HeroExperience.astro';
import MotionUniverses from '../components/MotionUniverses.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="CYL Neumáticos. Neumáticos para automóvil, camioneta, transporte y agro/vial en Neuquén y Añelo." />
    <meta name="theme-color" content="#e83421" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>CYL Neumáticos — Tu camino empieza acá</title>
  </head>
  <body>
    <Header />
    <main>
      <HeroExperience />
      <MotionUniverses />
    </main>
    <Footer />

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import { initTireScene } from '../three/TireScene';

      gsap.registerPlugin(ScrollTrigger);
      const canvas = document.querySelector('#tire-canvas');
      const track = document.querySelector('#hero-track');
      const progress = document.querySelector('#hero-progress');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (canvas instanceof HTMLCanvasElement && track instanceof HTMLElement) {
        initTireScene(canvas, track, progress instanceof HTMLElement ? progress : null, reduced);
      }

      if (!reduced) {
        gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((element) => {
          gsap.fromTo(element, { y: 54, opacity: 0 }, { y: 0, opacity: 1, duration: 1.05, ease: 'power3.out', scrollTrigger: { trigger: element, start: 'top 88%', once: true } });
        });
        gsap.utils.toArray<HTMLElement>('.route-image img').forEach((image) => {
          gsap.fromTo(image, { scale: 1.14 }, { scale: 1, ease: 'none', scrollTrigger: { trigger: image, start: 'top bottom', end: 'bottom top', scrub: 0.6 } });
        });
      }

      const header = document.querySelector('.site-header');
      const setHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 32);
      window.addEventListener('scroll', setHeader, { passive: true });
      setHeader();

      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
        link.addEventListener('click', (event) => {
          const target = document.querySelector(link.hash);
          if (!target) return;
          event.preventDefault();
          target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth' });
        });
      });
    </script>
  </body>
</html>
