---
import '../styles/global.css';
import Header from '../components/Header.astro';
import HeroExperience from '../components/HeroSport.astro';
import MotionUniverses from '../components/MotionUniverses.astro';
import AdvisoryDrive from '../components/AdvisoryDrive.astro';
import BrandMarquee from '../components/BrandMarquee.astro';
import '../styles/advisory-drive.css';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="CYL Neumáticos. Soluciones para automóvil, camioneta, transporte y agro/vial en Neuquén y Añelo." />
    <meta name="theme-color" content="#080808" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>CYL Neumáticos — Confianza en cada kilómetro</title>
  </head>
  <body>
    <Header />
    <main>
      <HeroExperience />
      <MotionUniverses />
      <AdvisoryDrive />
      <BrandMarquee />
    </main>
    <Footer />

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import { initTireScene } from '../three/SportWheelScene';

      gsap.registerPlugin(ScrollTrigger);
      const canvas = document.querySelector('#tire-canvas');
      const track = document.querySelector('#hero-track');
      const progress = document.querySelector('#hero-progress');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (canvas instanceof HTMLCanvasElement && track instanceof HTMLElement) {
        initTireScene(canvas, track, progress instanceof HTMLElement ? progress : null, reduced);
      }

      if (!reduced) {
        gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((element) => {
          gsap.fromTo(element, { y: 48, opacity: 0 }, { y: 0, opacity: 1, duration: 1, ease: 'power3.out', scrollTrigger: { trigger: element, start: 'top 88%', once: true } });
        });
        gsap.utils.toArray<HTMLElement>('.universe-card').forEach((card) => {
          const image = card.querySelector('img');
          if (!image) return;
          gsap.fromTo(image, { scale: 1.1 }, { scale: 1, ease: 'none', scrollTrigger: { trigger: card, start: 'top bottom', end: 'bottom top', scrub: 0.7 } });
        });
      }

      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
        link.addEventListener('click', (event) => {
          const target = document.querySelector(link.hash);
          if (!target) return;
          event.preventDefault();
          target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth' });
        });
      });
    </script>
  </body>
</html>
