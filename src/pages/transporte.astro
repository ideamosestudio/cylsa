---
import InternalPageLayout from '../layouts/InternalPageLayout.astro';
import '../styles/product-detail.css';
import { transporteProducts } from '../data/transporte-products';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<InternalPageLayout
  title="Transporte"
  description="Neumáticos para transporte en CYL Neumáticos."
  eyebrow="NUESTROS NEUMÁTICOS / 03"
  heading="TRANSPORTE"
  intro="Resistencia continua para media y larga distancia."
  heroImage="transporte.png"
  heroImageAlt="Neumático para transporte con iluminación roja"
  heroIndex="03"
  heroApplication="MEDIA / LARGA DISTANCIA"
  heroProfile="RESISTENCIA CONTINUA"
>
  <section class="category-products category-products--static" aria-label="Modelos de neumáticos para transporte">
    <div class="category-products__shell">
      <div class="category-products__grid">
        {transporteProducts.map((product, index) => (
          <a class="category-product-card" href={`${base}${product.slug}/`} aria-label={`Quiero ver el producto ${product.title}`}>
            <div class="category-product-card__visual">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <img src={`${base}${product.cardImage || product.heroImage}`} alt={product.heroImageAlt} width="640" height="640" loading="lazy" />
            </div>
            <div class="category-product-card__copy">
              <div class="category-product-card__meta">
                <span>{product.brand} / {product.segment}</span>
                <img src={`${base}images/brands/fate-logo-black.png`} alt="Fate" width="1165" height="450" loading="lazy" />
              </div>
              <h3>{product.model}{product.cardVariant && <em>{product.cardVariant}</em>}</h3>
              <p>Quiero ver este producto</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</InternalPageLayout>
